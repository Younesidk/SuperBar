<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The WinRT projection (no UI framework) for the media session API (Windows.Media.Control). -->
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);SYSLIB1054</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SuperBar.Core\SuperBar.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SuperBar.Tests" />
  </ItemGroup>
</Project>
