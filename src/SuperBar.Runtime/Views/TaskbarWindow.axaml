<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SuperBar.Runtime.ViewModels"
        xmlns:views="using:SuperBar.Runtime.Views"
        x:Class="SuperBar.Runtime.Views.TaskbarWindow"
        x:DataType="vm:TaskbarViewModel"
        Title="SuperBar Taskbar"
        WindowDecorations="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        CanResize="False"
        CanMinimize="False"
        CanMaximize="False"
        Background="Transparent"
        FontFamily="{DynamicResource ContentControlThemeFontFamily}">

  <!-- Default values; TaskbarWindow.ApplyAppearance overwrites these from settings at runtime. -->
  <Window.Resources>
    <SolidColorBrush x:Key="SB.Surface" Color="#D11A1D24" />
    <SolidColorBrush x:Key="SB.SurfaceBorder" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="SB.Foreground" Color="#F2F4F8" />
    <SolidColorBrush x:Key="SB.Subtle" Color="#9AA3B2" />
    <SolidColorBrush x:Key="SB.Hover" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="SB.Pressed" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SB.ActiveItem" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="SB.WidgetBackground" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="SB.Track" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="SB.Accent" Color="#5B8CFF" />
    <CornerRadius x:Key="SB.ItemCornerRadius">10</CornerRadius>
    <x:Double x:Key="SB.ItemSize">40</x:Double>
    <x:Double x:Key="SB.IconSize">26</x:Double>
    <x:Double x:Key="SB.ItemSpacing">6</x:Double>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock.sb-text">
      <Setter Property="Foreground" Value="{DynamicResource SB.Foreground}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.sb-subtle">
      <Setter Property="Foreground" Value="{DynamicResource SB.Subtle}" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.sb-meter-value">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="Border.sb-meter-track">
      <Setter Property="Background" Value="{DynamicResource SB.Track}" />
      <Setter Property="CornerRadius" Value="2" />
    </Style>
    <Style Selector="Border.sb-meter-fill">
      <Setter Property="Background" Value="{DynamicResource SB.Accent}" />
      <Setter Property="CornerRadius" Value="2" />
    </Style>

    <!-- Every interactive item on the bar. -->
    <Style Selector="Button.sb-item">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="{DynamicResource SB.ItemSize}" />
      <Setter Property="Height" Value="{DynamicResource SB.ItemSize}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="{DynamicResource SB.ItemCornerRadius}" />
      <Setter Property="Foreground" Value="{DynamicResource SB.Foreground}" />
    </Style>
    <Style Selector="Button.sb-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SB.Hover}" />
    </Style>
    <Style Selector="Button.sb-item:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SB.Pressed}" />
    </Style>
    <Style Selector="Button.sb-item:pressed">
      <Setter Property="RenderTransform" Value="scale(0.94)" />
    </Style>
    <Style Selector="Button.sb-wide">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="Button.sb-narrow">
      <Setter Property="Width" Value="28" />
    </Style>

    <!-- Application buttons -->
    <Style Selector="Button.sb-app.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SB.ActiveItem}" />
    </Style>
    <Style Selector="Border.sb-indicator">
      <Setter Property="Width" Value="6" />
      <Setter Property="Height" Value="3" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="{DynamicResource SB.Subtle}" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.sb-app.active Border.sb-indicator">
      <Setter Property="Width" Value="16" />
      <Setter Property="Background" Value="{DynamicResource SB.Accent}" />
    </Style>

    <!-- Widget slots -->
    <Style Selector="Border.sb-widget">
      <Setter Property="Background" Value="{DynamicResource SB.WidgetBackground}" />
      <Setter Property="CornerRadius" Value="{DynamicResource SB.ItemCornerRadius}" />
      <Setter Property="Height" Value="{DynamicResource SB.ItemSize}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Path.sb-glyph">
      <Setter Property="Stroke" Value="{DynamicResource SB.Foreground}" />
      <Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Stretch" Value="None" />
    </Style>
  </Window.Styles>

  <Window.DataTemplates>
    <!-- Start -->
    <DataTemplate DataType="vm:StartSectionViewModel">
      <Button Classes="sb-item" Command="{Binding OpenStartCommand}" ToolTip.Tip="Start">
        <Path Fill="{DynamicResource SB.Accent}" Width="18" Height="18" Stretch="Uniform"
              Data="M0,0 H8.5 V8.5 H0 Z M9.5,0 H18 V8.5 H9.5 Z M0,9.5 H8.5 V18 H0 Z M9.5,9.5 H18 V18 H9.5 Z" />
      </Button>
    </DataTemplate>

    <!-- Pinned + running applications -->
    <DataTemplate DataType="vm:AppsSectionViewModel">
      <ItemsControl ItemsSource="{Binding Apps}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SB.ItemSpacing}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:AppButtonViewModel">
            <Button Classes="sb-item sb-app"
                    Classes.active="{Binding IsActive}"
                    Command="{Binding ClickCommand}"
                    ToolTip.Tip="{Binding ToolTip}">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{Binding DisplayName}" IsEnabled="False" />
                  <MenuItem Header="Open new window" Command="{Binding LaunchNewCommand}" IsEnabled="{Binding CanLaunch}" />
                </ContextMenu>
              </Button.ContextMenu>
              <Panel Width="{DynamicResource SB.ItemSize}" Height="{DynamicResource SB.ItemSize}">
                <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}"
                       Width="{DynamicResource SB.IconSize}" Height="{DynamicResource SB.IconSize}"
                       RenderOptions.BitmapInterpolationMode="HighQuality"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Initial}" IsVisible="{Binding !HasIcon}" Classes="sb-text" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border Classes="sb-indicator" IsVisible="{Binding IsRunning}" />
              </Panel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>

    <!-- Hosted widget -->
    <DataTemplate DataType="vm:WidgetSectionViewModel">
      <Border Classes="sb-widget" Width="{Binding Width}">
        <ContentControl Content="{Binding View}" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
      </Border>
    </DataTemplate>

    <!-- System section -->
    <DataTemplate DataType="vm:SystemTraySectionViewModel">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="sb-item sb-narrow" ToolTip.Tip="{Binding OverflowToolTip}" Opacity="0.55">
          <Path Classes="sb-glyph" Data="M1,7 L6,2 L11,7" />
        </Button>
        <Button Classes="sb-item sb-wide" Command="{Binding OpenQuickSettingsCommand}" ToolTip.Tip="Quick settings (network, volume)">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <!-- network -->
            <Path Classes="sb-glyph" Data="M1,6 C5,2 11,2 15,6 M3.5,8.5 C6.5,5.8 9.5,5.8 12.5,8.5 M6,11 C7.2,10 8.8,10 10,11 M8,13.2 L8,13.3" />
            <!-- volume -->
            <Path Classes="sb-glyph" Data="M1,5.5 H4 L8,2 V14 L4,10.5 H1 Z M11,5 C12.5,6.5 12.5,9.5 11,11 M13.2,3 C16,5.6 16,10.4 13.2,13" />
          </StackPanel>
        </Button>
      </StackPanel>
    </DataTemplate>

    <!-- Clock -->
    <DataTemplate DataType="vm:ClockSectionViewModel">
      <Button Classes="sb-item sb-wide" Command="{Binding OpenNotificationCenterCommand}" ToolTip.Tip="{Binding ToolTip}">
        <StackPanel VerticalAlignment="Center" Spacing="0">
          <TextBlock Classes="sb-text" Text="{Binding Time}" HorizontalAlignment="Right" FontWeight="SemiBold" />
          <TextBlock Classes="sb-subtle" Text="{Binding Date}" HorizontalAlignment="Right" />
        </StackPanel>
      </Button>
    </DataTemplate>
  </Window.DataTemplates>

  <Border x:Name="Surface"
          Background="{DynamicResource SB.Surface}"
          BorderBrush="{DynamicResource SB.SurfaceBorder}"
          BorderThickness="0,1,0,0"
          Padding="{Binding SurfacePadding}">
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem Header="SuperBar Control Center" Command="{Binding OpenControlCenterCommand}" />
        <MenuItem Header="Task Manager" Command="{Binding OpenTaskManagerCommand}" />
        <Separator />
        <MenuItem Header="Exit SuperBar (restore Windows taskbar)" Command="{Binding ExitCommand}" />
      </ContextMenu>
    </Border.ContextMenu>

    <views:ZonePanel>
      <ItemsControl views:ZonePanel.Zone="Left" ItemsSource="{Binding LeftSections}" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SB.ItemSpacing}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
      <ItemsControl views:ZonePanel.Zone="Center" ItemsSource="{Binding CenterSections}" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SB.ItemSpacing}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
      <ItemsControl views:ZonePanel.Zone="Right" ItemsSource="{Binding RightSections}" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SB.ItemSpacing}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </views:ZonePanel>
  </Border>
</Window>
