<?xml version="1.0" encoding="utf-8"?>
<!--
  The Control Center's shared design tokens and styles. Every page takes its spacing, surfaces, typography and
  buttons from here; a page never hard-codes a width, a padding or a color of its own.

  Colors are WinUI theme brushes only (ThemeResource), so the styles follow the window's theme.
  Order matters: a StaticResource must be defined above the place that uses it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="using:SuperBar.ControlCenter.Views">

  <!-- ===== Tokens ===== -->

  <!-- Spacing scale. Use these for StackPanel.Spacing, Grid.ColumnSpacing / RowSpacing and the like. -->
  <x:Double x:Key="SpacingXS">4</x:Double>
  <x:Double x:Key="SpacingS">8</x:Double>
  <x:Double x:Key="SpacingM">12</x:Double>
  <x:Double x:Key="SpacingL">16</x:Double>
  <x:Double x:Key="SpacingXL">24</x:Double>

  <!-- Page column: its outer padding, and its width cap for single-column and for multi-column pages. -->
  <Thickness x:Key="PagePadding">36,28,36,36</Thickness>
  <x:Double x:Key="PageMaxWidthNarrow">960</x:Double>
  <x:Double x:Key="PageMaxWidthWide">1400</x:Double>

  <!-- Cards. CardGap is both the gap between stacked cards (the Card style's bottom margin) and between grid columns. -->
  <x:Double x:Key="CardGap">8</x:Double>
  <Thickness x:Key="CardMargin">0,0,0,8</Thickness>
  <Thickness x:Key="CardPadding">18,14,18,14</Thickness>
  <Thickness x:Key="CardPaddingCompact">14,10,14,10</Thickness>
  <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>
  <CornerRadius x:Key="InsetCornerRadius">6</CornerRadius>

  <!--
    Sizes that are not spacing: the side of an IconTile, the least width of a setting's combo box or number box (so a
    column of them lines up and does not resize with its selection), and the content width of a flyout panel.
  -->
  <x:Double x:Key="IconTileSize">36</x:Double>
  <x:Double x:Key="SettingControlMinWidth">160</x:Double>
  <x:Double x:Key="FlyoutContentWidth">340</x:Double>

  <!-- ===== Typography ===== -->

  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
  </Style>
  <Style x:Key="PageSubtitle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,4,0,20" />
  </Style>
  <!-- Heading of a group of cards inside a page. The first one on a page sets Margin="0,0,0,8". -->
  <Style x:Key="SectionHeader" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,16,0,8" />
    <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
  </Style>
  <!-- A setting's name. -->
  <Style x:Key="Label" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- A setting's explanation, a value read-out, any secondary text. -->
  <Style x:Key="Hint" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- Commands, paths and other literal text. -->
  <Style x:Key="CodeText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="IsTextSelectionEnabled" Value="True" />
  </Style>

  <!-- The product name in a hero card (About). -->
  <Style x:Key="HeroTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- ===== Surfaces ===== -->

  <!--
    The standard settings card. Its bottom margin is the gap to the next card, so cards are stacked in a plain
    StackPanel / ItemsControl or placed in a views:ResponsiveGrid without any spacing of their own.
  -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    <Setter Property="Margin" Value="{StaticResource CardMargin}" />
  </Style>
  <!-- A denser card, for rows in a list (one app, one layout item). -->
  <Style x:Key="CompactCard" TargetType="Border" BasedOn="{StaticResource Card}">
    <Setter Property="Padding" Value="{StaticResource CardPaddingCompact}" />
  </Style>
  <!-- A surface inside a card: an item of a list that lives in a card, a recessed block. -->
  <Style x:Key="InsetCard" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource InsetCornerRadius}" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <!-- A card that holds a destructive action: the same card with a red-tinted outline. -->
  <Style x:Key="DangerCard" TargetType="Border" BasedOn="{StaticResource Card}">
    <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
  </Style>
  <!-- Amber banner: planned / not implemented yet. -->
  <Style x:Key="NotImplemented" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,8,0,8" />
  </Style>
  <!-- A literal command or path shown as a block; put a CodeText TextBlock inside. -->
  <Style x:Key="CodeBlock" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource ControlFillColorInputActiveBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource InsetCornerRadius}" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <!--
    The app icon of a hero card: the full-color SuperBar icon at 56 px, drawn as it is. The icon brings its own
    plate, so it gets no tile or background behind it.
  -->
  <Style x:Key="HeroIcon" TargetType="Image">
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="56" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- The square behind an item's icon (a widget tile, the inspector header). Put one FontIcon inside (FontSize 16). -->
  <Style x:Key="IconTile" TargetType="Border">
    <Setter Property="Width" Value="{StaticResource IconTileSize}" />
    <Setter Property="Height" Value="{StaticResource IconTileSize}" />
    <Setter Property="CornerRadius" Value="{StaticResource InsetCornerRadius}" />
    <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- A hairline between the groups inside one card. -->
  <Style x:Key="Divider" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
  </Style>
  <!--
    The accent outline of a selected tile, laid over a TileButton in the same Grid cell. Show and hide it with
    Opacity, not Visibility: selecting must not cause a layout pass.
  -->
  <Style x:Key="SelectionRing" TargetType="Border">
    <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <!-- ===== Pills (badges) ===== -->
  <!-- A Border with one TextBlock: Pill + PillText (neutral), PillCaution + PillCautionText ("Coming soon"). -->

  <Style x:Key="Pill" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,1,8,2" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="PillText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="PillCaution" TargetType="Border" BasedOn="{StaticResource Pill}">
    <Setter Property="Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style x:Key="PillCautionText" TargetType="TextBlock" BasedOn="{StaticResource PillText}">
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
  </Style>

  <!-- ===== Buttons ===== -->
  <!-- Safe actions use the default Button (and AccentButtonStyle for a page's primary action). -->

  <!-- Shared by the buttons below: the button's own colors, with a light overlay on hover and press. -->
  <ControlTemplate x:Key="OverlayButtonTemplate" TargetType="Button">
    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Target="Overlay.Opacity" Value="1" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Target="Overlay.Opacity" Value="0.5" />
              <Setter Target="ContentPresenter.Opacity" Value="0.8" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="RootGrid.Opacity" Value="0.4" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Border x:Name="Overlay" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Opacity="0"
              CornerRadius="{TemplateBinding CornerRadius}" />
      <ContentPresenter x:Name="ContentPresenter"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        ContentTransitions="{TemplateBinding ContentTransitions}"
                        Foreground="{TemplateBinding Foreground}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        AutomationProperties.AccessibilityView="Raw" />
    </Grid>
  </ControlTemplate>

  <!-- A destructive action on a page (reset, remove): red text on a red-tinted fill. Confirm before acting. -->
  <Style x:Key="DangerButton" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
    <Setter Property="Padding" Value="11,5,11,6" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="Template" Value="{StaticResource OverlayButtonTemplate}" />
  </Style>
  <!-- The confirming button of a destructive dialog: solid red. -->
  <Style x:Key="DangerAccentButton" TargetType="Button" BasedOn="{StaticResource DangerButton}">
    <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <!-- A quiet 32 px icon button (one FontIcon, FontSize 14). Always give it a tooltip and an AutomationProperties.Name. -->
  <Style x:Key="SubtleIconButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="Template" Value="{StaticResource OverlayButtonTemplate}" />
  </Style>

  <!--
    A card that is one button: a selectable tile. It looks like a CompactCard and fills its cell; the caller lays out
    the content. Other controls of the tile (a switch) are siblings laid over it, never children of the button.
  -->
  <Style x:Key="TileButton" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    <Setter Property="Padding" Value="{StaticResource CardPaddingCompact}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="Template" Value="{StaticResource OverlayButtonTemplate}" />
  </Style>

  <!-- Round accent swatch; keeps its own color on hover (a ring shows instead). -->
  <Style x:Key="SwatchButton" TargetType="Button">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="RootGrid">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Ring.BorderBrush" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Ring.BorderBrush" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Setter Target="RootGrid.Opacity" Value="0.85" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="RootGrid.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Ring" CornerRadius="14" BorderThickness="2" BorderBrush="Transparent"
                    Background="{TemplateBinding Background}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Page container ===== -->

  <!--
    Implicit style of views:PageContainer, the root of every page template: a vertical scroller around one centered
    column (capped at ContentMaxWidth) holding the title row, the subtitle and the page content.
  -->
  <Style TargetType="views:PageContainer">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="ContentMaxWidth" Value="{StaticResource PageMaxWidthNarrow}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="views:PageContainer">
          <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto" IsTabStop="False">
            <!--
              The scroll viewer's own child is a plain grid that fills the viewport; the capped column is inside it.
              With MaxWidth and the margin on the scroll viewer's direct child, the column sat right of center in a
              maximized window (measured 229 px off at 1920 wide, with a viewport of the right size).
            -->
            <Grid>
              <!-- Stretch + MaxWidth centers the column once the window is wider than the cap. -->
              <Grid MaxWidth="{TemplateBinding ContentMaxWidth}" Margin="{StaticResource PagePadding}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource PageTitle}" VerticalAlignment="Center" Text="{TemplateBinding Title}" />
                <!--
                  A ContentControl, not a ContentPresenter: inside a ContentControl's template, a ContentPresenter whose
                  Content is null binds itself to the control's Content, and the page content would get two parents.
                -->
                <ContentControl Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" IsTabStop="False"
                                Content="{TemplateBinding HeaderAction}" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource PageSubtitle}"
                           Text="{TemplateBinding Subtitle}" />
                <ContentPresenter Grid.Row="2" Grid.ColumnSpan="2"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Grid>
            </Grid>
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
