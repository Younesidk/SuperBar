<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\SuperBar.WinUI.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>SuperBar</AssemblyName>
    <RootNamespace>SuperBar.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Program.Main is hand-written: Velopack, crash safety nets and single-instance checks must run before WinUI starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SuperBar.Core\SuperBar.Core.csproj" />
    <ProjectReference Include="..\SuperBar.Infrastructure\SuperBar.Infrastructure.csproj" />
    <ProjectReference Include="..\SuperBar.Windows\SuperBar.Windows.csproj" />
    <ProjectReference Include="..\SuperBar.Widgets\SuperBar.Widgets.csproj" />
    <ProjectReference Include="..\SuperBar.Runtime\SuperBar.Runtime.csproj" />
    <ProjectReference Include="..\SuperBar.ControlCenter\SuperBar.ControlCenter.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
</Project>
